<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:KönyvTár.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KönyvTár.Views.Main.ProfileView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">
            <StackPanel Spacing="5">
                <TextBlock Text="Profil" Classes="pageTitle" />
                <TextBlock Text="Személyes adatok és fiókinformációk."
                           Classes="pageSubtitle" />
            </StackPanel>

            <Border Classes="card" Padding="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Grid.Column="0" Width="56" Height="56" CornerRadius="28"
                            Background="{DynamicResource ButtonHoverBackground}">
                        <ic:MaterialIcon Kind="AccountCircle" Width="30" Height="30"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{DynamicResource FocusBorder}" />
                    </Border>
                    <StackPanel Grid.Row="0" Grid.Column="1" x:Name="ProfileSummary"  VerticalAlignment="Center" Spacing="8" >
                        <TextBlock x:Name="NameText" Text="{Binding CurrentUserName}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}" />
                        <TextBlock x:Name="EmailText" Text="{Binding CurrentUserEmail}" Classes="pageSubtitle" />
                        <TextBlock Text="{Binding CurrentUserRoleLabel}" Classes="pageSubtitle" />
                    </StackPanel>
                    <StackPanel x:Name="ProfileActions" Grid.Column="1" Grid.Row="1"
                                Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button x:Name="EditProfileButton" Content="Profil szerkesztése" Classes="secondaryButton" />
                        <Button x:Name="ShowPasswordButton" Content="Jelszó módosítása" Classes="secondaryButton" />
                    </StackPanel>
                    <TextBlock x:Name="ProfileStatus" Grid.Column="1" Grid.Row="2"
                               Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </Grid>
            </Border>

            <Border x:Name="ProfileEditPanel" Classes="card" Padding="24" IsVisible="False">
                <StackPanel x:Name="ProfileEditor" Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Keresztnév" />
                        <TextBox x:Name="FirstNameBox" Classes="inputArea" Margin="0" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Vezetéknév" />
                        <TextBox x:Name="LastNameBox" Classes="inputArea" Margin="0" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="E-mail cím" />
                        <TextBox x:Name="EmailBox" Classes="inputArea" Margin="0" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Telefonszám" />
                        <TextBox x:Name="PhoneBox" Classes="inputArea" Margin="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveProfileButton" Content="Mentés" Classes="primaryButton" />
                        <Button x:Name="CancelProfileButton" Content="Mégse" Classes="secondaryButton" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="PasswordPanel" Classes="card" Padding="24" IsVisible="False">
                <StackPanel Spacing="12">
                    <TextBlock Text="Jelszó módosítása" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                    <TextBox x:Name="CurrentPasswordBox" PasswordChar="•" PlaceholderText="Jelenlegi jelszó" Classes="inputArea" Margin="0" />
                    <TextBox x:Name="NewPasswordBox" PasswordChar="•" PlaceholderText="Új jelszó (legalább 8 karakter)" Classes="inputArea" Margin="0" />
                    <TextBox x:Name="ConfirmPasswordBox" PasswordChar="•" PlaceholderText="Új jelszó megerősítése" Classes="inputArea" Margin="0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ChangePasswordButton" Content="Mentés" Classes="primaryButton" />
                        <Button x:Name="ClosePasswordButton" Content="Mégse" Classes="secondaryButton" />
                    </StackPanel>
                    <TextBlock x:Name="PasswordStatus" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" Margin="0" Padding="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
