<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:CompileBindings="False"
             x:Class="KönyvTár.Views.Main.LibraryView"
             Background="{DynamicResource WindowBackground}">
    <Grid RowDefinitions="Auto,*" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding BookTableColumnWidth}" />
            <ColumnDefinition Width="{Binding BookDetailsColumnWidth}" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="16" Margin="0,0,0,12"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                CornerRadius="10">
            <Grid ColumnDefinitions="2*,Auto" ColumnSpacing="12">
                <TextBox Grid.Column="0" x:Name="FilterTextBox" Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="Keresés cím, szerző vagy kiadó alapján..." >
                    <TextBox.InnerRightContent>
                        <Button Classes="linkButton" Click="EmptyFilterTextBox" Padding="0 0 10 0">
                            <ic:MaterialIcon Kind="Close"/>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
                <ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding StatusFilter, Mode=TwoWay}" />
            </Grid>
        </Border>

        <TableView Grid.Row="1" Grid.Column="0" ItemsSource="{Binding FilteredBooks}"
                   SelectedItem="{Binding SelectedBook, Mode=TwoWay}" SelectionMode="Toggle"
                   CanUserResizeColumns="False" CornerRadius="10">
            <TableView.Columns>
                <TableViewColumn Header="Cím" Binding="{Binding Title}" Width="2*"/>
                <TableViewColumn Header="Szerző" Binding="{Binding Author}" Width="2*"/>
                <TableViewColumn Header="Kiadó" Binding="{Binding Publisher}" Width="2*"/>
                <TableViewColumn Header="Leltári szám" Binding="{Binding InventoryCode}" Width="*"/>
                <TableViewColumn Header="Állapot" Binding="{Binding Status}" Width="*"/>
            </TableView.Columns>
        </TableView>

        <Border Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Padding="00  0 5 0"
                IsVisible="{Binding HasSelectedBook}"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer x:Name="DetailsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="15 20 15 20">
                <StackPanel Spacing="12">
                <TextBlock Text="Könyv adatai" FontSize="20" FontWeight="SemiBold" />
                <Border Height="1" Background="{DynamicResource BorderColor}" />
                <StackPanel Spacing="4">
                    <TextBlock Text="Cím" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedBook.Title}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Szerző" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedBook.Author}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Kiadó" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedBook.Publisher}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="ISBN" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedBook.ISBN}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Leltári szám" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedBook.InventoryCode}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Állapot" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedBook.Status}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Height="1" Margin="0,8,0,0" Background="{DynamicResource BorderColor}" />
                <TextBlock Text="Kölcsönzés" FontSize="20" FontWeight="SemiBold" />
                <StackPanel Spacing="4">
                    <TextBlock Text="Felhasználó" FontWeight="SemiBold" Margin="0 0 0 10" />
                    <AutoCompleteBox ItemsSource="{Binding Users}"
                                     SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                     ValueMemberBinding="{Binding Name}"
                                     FilterMode="Contains"
                                     MinimumPrefixLength="1"
                                     PlaceholderText="Felhasználó keresése..."  />
                </StackPanel>
                <TextBlock Text="Kölcsönzés időszaka" FontWeight="SemiBold" />
                <Calendar x:Name="LendingCalendar"
                          SelectionMode="SingleRange"
                          IsVisible="{Binding IsCustomLendingDuration}"
                          HorizontalAlignment="Left"/>
                <ComboBox ItemsSource="{Binding LendingDurationOptions}"
                          SelectedItem="{Binding SelectedLendingDuration, Mode=TwoWay}" />
                <TextBox Text="{Binding LendingDateRange}" IsReadOnly="True"
                         Height="36" IsEnabled="False" />
                <Button Content="Kölcsönzés indítása" Command="{Binding InitiateLendingCommand}"
                        HorizontalAlignment="Stretch" Classes="primaryButton" />
                <TextBlock Text="{Binding LendingStatusMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
