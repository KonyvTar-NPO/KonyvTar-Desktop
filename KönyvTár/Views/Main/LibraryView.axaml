<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:CompileBindings="False"
             x:Class="KönyvTár.Views.Main.LibraryView"
             Background="{DynamicResource WindowBackground}">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="20" Margin="24">
        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="Könyvtár kezelése" Classes="pageTitle" />
            <TextBlock Text="Könyvek keresése, szerkesztése és kölcsönzése."
                       Classes="pageSubtitle" />
        </StackPanel>

        <Border Grid.Row="1" Classes="card" Padding="16">
            <Grid ColumnDefinitions="2*,Auto" ColumnSpacing="12">
                <TextBox Grid.Column="0" x:Name="FilterTextBox" Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="Keresés cím, szerző vagy kiadó alapján..." >
                    <TextBox.InnerRightContent>
                        <Button Classes="linkButton" Click="EmptyFilterTextBox" Padding="0 0 10 0">
                            <ic:MaterialIcon Kind="Close"/>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
                <ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding StatusFilter, Mode=TwoWay}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding BookTableColumnWidth}" />
                <ColumnDefinition Width="{Binding BookDetailsColumnWidth}" />
            </Grid.ColumnDefinitions>

            <TableView Grid.Column="0" ItemsSource="{Binding FilteredBooks}"
                       SelectedItem="{Binding SelectedBook, Mode=TwoWay}" SelectionMode="Toggle"
                       CanUserResizeColumns="False" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <TableView.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#E2E8F0" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#2E3748" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TableView.Resources>
                <TableView.Columns>
                    <TableViewColumn Header="Cím" Binding="{Binding Title}" Width="2*"/>
                    <TableViewColumn Header="Szerző" Binding="{Binding Author}" Width="2*"/>
                    <TableViewColumn Header="Kiadó" Binding="{Binding Publisher}" Width="2*"/>
                    <TableViewColumn Header="Leltári szám" Binding="{Binding InventoryCode}" Width="*"/>
                    <TableViewColumn Header="Állapot" Binding="{Binding Status}" Width="*"/>
                </TableView.Columns>
            </TableView>

            <Border Grid.Column="1" IsVisible="{Binding HasSelectedBook}" Classes="card">
            <ScrollViewer x:Name="DetailsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel Spacing="12">
                    <Grid HorizontalAlignment="Stretch" >
                        <TextBlock Text="Könyv adatai" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Classes="iconButton" Click="EditBookData">
                                <ic:MaterialIcon Kind="Pencil"/>
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderColor}" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Cím" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                        <TextBlock Text="{Binding SelectedBook.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Szerző" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                        <TextBlock Text="{Binding SelectedBook.Author}" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Kiadó" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                        <TextBlock Text="{Binding SelectedBook.Publisher}" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="ISBN" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                        <TextBlock Text="{Binding SelectedBook.ISBN}" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Leltári szám" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                        <TextBlock Text="{Binding SelectedBook.InventoryCode}" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Állapot" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                        <TextBlock Text="{Binding SelectedBook.Status}" FontSize="16" FontWeight="Medium" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Height="1" Margin="0,8,0,0" Background="{DynamicResource BorderColor}" />
                    <StackPanel IsVisible="{Binding IsSelectedBookLent}" Spacing="12">
                        <TextBlock Text="Kölcsönzés adatai" FontSize="22" FontWeight="SemiBold" />
                        <Border Height="1" Background="{DynamicResource BorderColor}" />
                        <StackPanel IsVisible="{Binding HasSelectedBookLending}" Spacing="8">
                            <TextBlock Text="Azonosító" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock Text="{Binding SelectedBookLending.Id}" FontSize="16" />
                            <TextBlock Text="Felhasználó" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock Text="{Binding SelectedBookLending.UserName}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Kölcsönzés dátuma" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock Text="{Binding SelectedBookLending.BorrowedAt, StringFormat='{}{0:yyyy. MM. dd.}'}" FontSize="16" />
                            <TextBlock Text="Lejárati dátum" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock Text="{Binding SelectedBookLending.DueDate, StringFormat='{}{0:yyyy. MM. dd.}'}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Állapot" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock Text="{Binding SelectedBookLending.Status}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="E-mail értesítés" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock Text="{Binding SelectedBookLending.NotifyByEmail}" FontSize="16" />
                        </StackPanel>
                        <TextBlock Text="Nincs aktív kölcsönzési rekord ehhez a könyvhöz."
                                   IsVisible="{Binding ShowMissingSelectedBookLending}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSelectedBookLending}">
                            <Button Content="Szerkesztés" Click="EditSelectedLending"
                                    Classes="secondaryButton panelButton" />
                            <Button Content="Visszahozta" Click="ReturnSelectedLending"
                                    Classes="primaryButton panelButton" />
                            <Button Content="Törlés" Click="DeleteSelectedLending"
                                    Classes="secondaryButton panelButton"
                                    Foreground="{DynamicResource DangerText}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding CanStartLending}" Spacing="12">
                        <TextBlock Text="Kölcsönzés indítása" FontSize="20" FontWeight="SemiBold" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Felhasználó" FontWeight="SemiBold" Margin="0 0 0 10" />
                            <AutoCompleteBox ItemsSource="{Binding Users}"
                                             Text="{Binding SelectedUserSearchText, Mode=TwoWay}"
                                             SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                             ValueMemberBinding="{Binding Name}"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="1"
                                             PlaceholderText="Felhasználó keresése..." />
                        </StackPanel>
                        <TextBlock Text="Kölcsönzés időszaka" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding LendingDurationOptions}"
                                  SelectedItem="{Binding SelectedLendingDuration, Mode=TwoWay}" />
                        <StackPanel IsVisible="{Binding IsCustomLendingDuration}" Spacing="8">
                            <TextBlock Text="Lejárati dátum" FontWeight="SemiBold" />
                            <DatePicker x:Name="ToDatePicker" />
                        </StackPanel>
                        <TextBox Text="{Binding LendingDateRange}" IsReadOnly="True"
                                 Height="36" IsEnabled="False" />
                        <Button Content="Kölcsönzés indítása" Command="{Binding InitiateLendingCommand}"
                                HorizontalAlignment="Stretch" Classes="primaryButton" />
                        <TextBlock Text="{Binding LendingStatusMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
