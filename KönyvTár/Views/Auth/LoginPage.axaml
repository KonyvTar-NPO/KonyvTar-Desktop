<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KönyvTár.Views.Auth.LoginPage">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" VerticalAlignment="Center" MaxWidth="300" Spacing="0">
            <TextBlock Text="Bejelentkezés" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0 50 0 30"/>
            <ToggleButton x:Name="LoginMethodToggle"
                          IsChecked="False"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,24"
                          Classes="accountTypeToggle">
                <Grid ColumnDefinitions="*,*">
                    <TextBlock Grid.Column="0" Text="Jelszóval" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Kóddal" HorizontalAlignment="Center"/>
                </Grid>
            </ToggleButton>
        </StackPanel>

        <ContentControl Grid.Row="1" x:Name="LoginHost" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0 0 0 10">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0 0 0 5" Spacing="5">
                <TextBlock Text="Nincs még fiókod?" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                <Button x:Name="RegisterButton" Content="Regisztráció" Classes="linkButton"/>
            </StackPanel>
            <TextBlock Text="© 2026 KönyvTár" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
