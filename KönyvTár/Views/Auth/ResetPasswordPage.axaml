<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KönyvTár.Views.Auth.ResetPasswordPage">
    <Grid RowDefinitions="*,Auto,*">
        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="300" Spacing="0">
            <TextBlock Text="Új jelszó" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0 0 0 24"/>
            <TextBlock Text="Új jelszó" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="PasswordTextBox" PasswordChar="•" Classes="inputArea"/>
            <TextBlock Text="Új jelszó megerősítése" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="ConfirmPasswordTextBox" PasswordChar="•" Classes="inputArea"/>
            <Button x:Name="SaveButton" Content="Jelszó mentése" Classes="primaryButton" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource DangerText}" FontSize="13" TextWrapping="Wrap" Margin="0 10 0 0" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0 0 0 10">
            <Button x:Name="BackButton" Content="Vissza" Classes="linkButton" HorizontalAlignment="Center" Margin="0 0 0 10"/>
            <TextBlock Text="© 2026 KönyvTár" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
