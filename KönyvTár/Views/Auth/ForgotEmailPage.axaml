<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KönyvTár.Views.Auth.ForgotEmailPage">
    <Grid RowDefinitions="*,Auto,*">
        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="300" Spacing="0">
            <TextBlock Text="Jelszó visszaállítása" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0 0 0 14"/>
            <TextBlock Text="Add meg e-mail címed a 6 jegyű kódhoz." FontSize="14" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0 0 0 22"/>
            <TextBlock Text="E-mail cím" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="EmailTextBox" Classes="inputArea"/>
            <Button x:Name="SendCodeButton" Content="Kód küldése" Classes="primaryButton"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource DangerText}" FontSize="13" TextWrapping="Wrap" Margin="0 10 0 0" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0 0 0 10">
            <Button x:Name="BackButton" Content="Vissza a bejelentkezéshez" Classes="linkButton" HorizontalAlignment="Center" Margin="0 0 0 10"/>
            <TextBlock Text="© 2026 KönyvTár" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
