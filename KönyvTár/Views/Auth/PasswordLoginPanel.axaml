<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KönyvTár.Views.Auth.PasswordLoginPanel">
    <Grid RowDefinitions="*,Auto,*">
        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="300" Spacing="0">
            <TextBlock Text="E-mail cím" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="EmailTextBox" Classes="inputArea"/>
            <TextBlock Text="Jelszó" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="PasswordTextBox" PasswordChar="•" Classes="inputArea" Margin="0 8 0 5"/>
            <Button x:Name="ForgotPasswordButton" Content="Elfelejtetted a jelszavad?" Classes="linkButton" HorizontalAlignment="Right" />
            <Button x:Name="LoginButton" Content="Belépés" Classes="primaryButton" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource DangerText}" FontSize="13" TextWrapping="Wrap" Margin="0 10 0 0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
